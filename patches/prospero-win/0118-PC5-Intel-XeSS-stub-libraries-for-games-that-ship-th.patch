++/*
++ * Intel XeSS (Super Resolution) stub library.
++ *
++ * Every public function from Intel's XeSS SDK, returning
++ * XESS_RESULT_ERROR_UNSUPPORTED_DEVICE where a result is expected,
++ * so games that statically import libxess.dll load and discover
++ * there is no Intel GPU without crashing.
++ *
++ * LGPL-2.1-or-later
++ */
++
++#include <stddef.h>
++
++#define XESS_RESULT_SUCCESS                    0
++#define XESS_RESULT_ERROR_UNSUPPORTED_DEVICE (-1)
++
++typedef int xess_result_t;
++typedef void *xess_context_handle_t;
++
++typedef struct {
++    unsigned int major;
++    unsigned int minor;
++    unsigned int patch;
++    unsigned int reserved;
++} xess_version_t;
++
++typedef struct {
++    int min_driver_supported;
++    int optimal_driver_supported;
++    int xess_available;
++} xess_properties_t;
++
++typedef void (*xess_logging_callback_t)(const char *, void *);
++
++/* xessGetVersion: return zeroes. */
++xess_result_t __cdecl xessGetVersion(xess_version_t *version)
++{
++    if (version) { version->major = 0; version->minor = 0; version->patch = 0; version->reserved = 0; }
++    return XESS_RESULT_SUCCESS;
++}
++
++/* xessGetIntelXeFXVersion: return zeroes. */
++xess_result_t __cdecl xessGetIntelXeFXVersion(xess_version_t *version)
++{
++    if (version) { version->major = 0; version->minor = 0; version->patch = 0; version->reserved = 0; }
++    return XESS_RESULT_SUCCESS;
++}
++
++/* xessGetProperties: report everything unavailable. */
++xess_result_t __cdecl xessGetProperties(xess_context_handle_t context, xess_properties_t *props)
++{
++    if (props) { props->min_driver_supported = 0; props->optimal_driver_supported = 0; props->xess_available = 0; }
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetInputResolution: no resolution to report. */
++xess_result_t __cdecl xessGetInputResolution(xess_context_handle_t context,
++    unsigned int *width, unsigned int *height,
++    unsigned int *right, unsigned int *bottom)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetOptimalInputResolution: no resolution to report. */
++xess_result_t __cdecl xessGetOptimalInputResolution(xess_context_handle_t context,
++    int quality, unsigned int output_width, unsigned int output_height,
++    unsigned int *input_width, unsigned int *input_height,
++    unsigned int *right, unsigned int *bottom)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetJitterScale: no jitter. */
++xess_result_t __cdecl xessGetJitterScale(xess_context_handle_t context, float *x, float *y)
++{
++    if (x) *x = 0.0f;
++    if (y) *y = 0.0f;
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetVelocityScale: no velocity. */
++xess_result_t __cdecl xessGetVelocityScale(xess_context_handle_t context, float *x, float *y)
++{
++    if (x) *x = 0.0f;
++    if (y) *y = 0.0f;
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessDestroyContext: nothing to destroy. */
++xess_result_t __cdecl xessDestroyContext(xess_context_handle_t context)
++{
++    return XESS_RESULT_SUCCESS;
++}
++
++/* xessSetJitterScale: accept silently. */
++xess_result_t __cdecl xessSetJitterScale(xess_context_handle_t context, float x, float y)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessSetVelocityScale: accept silently. */
++xess_result_t __cdecl xessSetVelocityScale(xess_context_handle_t context, float x, float y)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessSetExposureMultiplier: accept silently. */
++xess_result_t __cdecl xessSetExposureMultiplier(xess_context_handle_t context, float multiplier)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetExposureMultiplier: no value. */
++xess_result_t __cdecl xessGetExposureMultiplier(xess_context_handle_t context, float *multiplier)
++{
++    if (multiplier) *multiplier = 1.0f;
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessSetMaxResponsiveMaskValue: accept silently. */
++xess_result_t __cdecl xessSetMaxResponsiveMaskValue(xess_context_handle_t context, float value)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetMaxResponsiveMaskValue: no value. */
++xess_result_t __cdecl xessGetMaxResponsiveMaskValue(xess_context_handle_t context, float *value)
++{
++    if (value) *value = 0.0f;
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessSetLoggingCallback: accept and ignore. */
++xess_result_t __cdecl xessSetLoggingCallback(xess_context_handle_t context, xess_logging_callback_t callback)
++{
++    return XESS_RESULT_SUCCESS;
++}
++
++/* xessIsOptimalDriver: no, there's no Intel driver. */
++xess_result_t __cdecl xessIsOptimalDriver(xess_context_handle_t context)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessForceLegacyScaleFactors: accept silently. */
++xess_result_t __cdecl xessForceLegacyScaleFactors(xess_context_handle_t context, int force)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessGetPipelineBuildStatus: not built. */
++xess_result_t __cdecl xessGetPipelineBuildStatus(xess_context_handle_t context)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
