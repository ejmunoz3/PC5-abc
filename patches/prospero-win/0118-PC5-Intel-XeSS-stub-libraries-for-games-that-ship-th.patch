++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessD3D12GetInitParams: no params. */
++xess_result_t __cdecl xessD3D12GetInitParams(xess_context_handle_t context, void *init_params)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xessD3D12Execute: nothing to execute. */
++xess_result_t __cdecl xessD3D12Execute(xess_context_handle_t context, void *cmd_list, void *exec_params)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
