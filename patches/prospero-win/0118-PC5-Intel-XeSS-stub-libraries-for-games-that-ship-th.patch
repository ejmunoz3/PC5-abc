++++ b/dlls/libxell/libxell.spec
+@@ -0,0 +1,7 @@
++@ cdecl xellD3D12CreateContext(ptr ptr)
++@ cdecl xellDestroyContext(ptr)
++@ cdecl xellGetVersion(ptr)
++@ cdecl xellSetLoggingCallback(ptr ptr)
++@ cdecl xellSetSleepMode(ptr long)
++@ cdecl xellSleep(ptr)
++@ cdecl xellAddMarkerData(ptr long ptr long)
+diff --git a/dlls/libxell/libxell_main.c b/dlls/libxell/libxell_main.c
+new file mode 100644
+index 0000000..c3d4e5f
+--- /dev/null
++++ b/dlls/libxell/libxell_main.c
+@@ -0,0 +1,71 @@
++/*
++ * Intel XeLL (XeSS Low Latency) stub library.
++ *
++ * Every public function from Intel's XeSS SDK, returning
++ * XESS_RESULT_ERROR_UNSUPPORTED_DEVICE where a result is expected,
++ * so games that statically import libxell.dll load and discover
++ * there is no Intel GPU without crashing.
++ *
++ * LGPL-2.1-or-later
++ */
++
++#include <stddef.h>
++
++#define XESS_RESULT_ERROR_UNSUPPORTED_DEVICE (-1)
++
++typedef int xess_result_t;
++typedef void *xess_context_handle_t;
++typedef unsigned int xess_version_t;
++
++typedef struct {
++    unsigned int major;
++    unsigned int minor;
++    unsigned int patch;
++    unsigned int reserved;
++} xess_version_struct_t;
++
++typedef void (*xess_logging_callback_t)(const char *, void *);
++
++/* xellD3D12CreateContext: answer "unsupported" so the game doesn't try to use XeLL. */
++xess_result_t __cdecl xellD3D12CreateContext(void *d3d12_device, xess_context_handle_t *context)
++{
++    if (context) *context = NULL;
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xellDestroyContext: nothing to destroy. */
++xess_result_t __cdecl xellDestroyContext(xess_context_handle_t context)
++{
++    return 0; /* XESS_RESULT_SUCCESS */
++}
++
++/* xellGetVersion: return zeroes. */
++xess_result_t __cdecl xellGetVersion(xess_version_struct_t *version)
++{
++    if (version) { version->major = 0; version->minor = 0; version->patch = 0; version->reserved = 0; }
++    return 0;
++}
++
++/* xellSetLoggingCallback: accept and ignore. */
++xess_result_t __cdecl xellSetLoggingCallback(xess_context_handle_t context, xess_logging_callback_t callback)
++{
++    return 0;
++}
++
++/* xellSetSleepMode: no device to set a sleep mode on. */
++xess_result_t __cdecl xellSetSleepMode(xess_context_handle_t context, int mode)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xellSleep: nothing to sleep. */
++xess_result_t __cdecl xellSleep(xess_context_handle_t context)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
++
++/* xellAddMarkerData: no device. */
++xess_result_t __cdecl xellAddMarkerData(xess_context_handle_t context, unsigned int type, void *data, unsigned int size)
++{
++    return XESS_RESULT_ERROR_UNSUPPORTED_DEVICE;
++}
